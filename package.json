{
	"name": "@extws/server",
	"version": "0.3.0-dev",
	"description": "Base for simple ans powerful WebSocket server",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		},
		"./dev": {
			"types": {
				"import": "./dist/dev.d.mts",
				"require": "./dist/dev.d.cts"
			},
			"import": "./dist/dev.mjs",
			"require": "./dist/dev.cjs"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"nanoid": "6.0.1",
		"neoevents": "0.3.0"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.1",
		"@types/node": "20.19.43",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0",
		"vitest": "4.0.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts src/dev.ts --clean --publint --unused --dts --format esm --format cjs",
		"check": "lint && bun run build && bun run test",
		"test": "bun test && vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server.git"
	},
	"keywords": [
		"websocket",
		"ws",
		"networking",
		"json",
		"rtc"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server/issues"
	},
	"homepage": "https://github.com/extws-team/server#readme"
}
