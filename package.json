{
	"name": "@extws/server",
	"version": "0.2.1-beta.1",
	"description": "Base for simple ans powerful WebSocket server",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/esm/main.js",
	"types": "dist/esm/main.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/main.js",
			"require": "./dist/main.cjs"
		},
		"./dev": {
			"import": "./dist/esm/dev.js",
			"types": "./dist/esm/dev.d.ts"
		}
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"dependencies": {
		"nanoid": "4.0.2",
		"neoevents": "^0.2.0"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@kirick/eslint-config": "0.1.30",
		"@types/node": "^22.7.4",
		"eslint": "9.10.0",
		"typescript": "5.5.4",
		"vitest": "2.1.2"
	},
	"scripts": {
		"build": "rm -r dist ; bun run build:ts && bun run build:cjs",
		"build:cjs": "bun build src/main.ts --outfile=dist/main.cjs --platform=node --format=cjs --packages=external",
		"build:ts": "rm -r dist/esm ; tsc",
		"lint": "eslint . && tsc --skipLibCheck --noemit",
		"publish:npm": "bun run lint && bun run build && bun run test && npm publish",
		"test": "vitest run --no-file-parallelism",
		"# test:note": "# no bun test because it doesn't support fake timers for setTimeout/setInterval"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server.git"
	},
	"keywords": [
		"websocket",
		"ws",
		"networking",
		"json",
		"rtc"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server/issues"
	},
	"homepage": "https://github.com/extws-team/server#readme"
}
